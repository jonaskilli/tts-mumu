    "isNeedDecode": function() { return false },  // MP3格式，不需要解码

    "onStop": function() {
        logger.d("onStop被调用")
        try {
            if (ws != null) {
                ws.close(1000, "stop")
            }
        } catch(e) {
            logger.w("onStop关闭ws出错: " + e)
        }
    },

    "getAudioV2": function(request, callback2) {
        check()

        // 调试：输出完整的request对象
        logger.d("request.voice = " + request.voice)
        logger.d("request.voice类型 = " + typeof request.voice)

        // 参数转换: TTS Server的rate(0-100)转换为文心的spd(0-10)
        // 默认语速调快1.2倍 (默认60对应spd=6)
        let speed = Math.round(((request.rate || 60) / 100) * 10)
        let pitch = Math.round(((request.pitch || 50) / 100) * 10)
        let volume = Math.round(((request.volume || 50) / 100) * 10)

        callback = callback2
        audioState = { chunks: [], totalLength: 0, isFinished: false, receivedLastChunk: false }

        // 处理音色ID
        let voiceId = request.voice
        if (!voiceId || voiceId === "") {
            voiceId = "4343"
        }
        logger.d("音色ID: " + voiceId)
        
        req = {
            text: request.text,
            voice: voiceId,
            speed: speed,
            pitch: pitch,
            volume: volume
        }

        let txtLen = String(req.text).length
        let logText = txtLen > 30 ? req.text.substring(0, 30) + "..." : req.text
        logger.i("文心: " + logText)

        if (ws != null) {
            logger.d("关闭旧WebSocket")
            try { ws.close(1000, "restart") } catch(e) {}
            ws = null
        }

        connectWebSocket()
    }
}

function connectWebSocket() {
    let wsUrl = "wss://tts.baidu.com/ws/sdktts?sn=" + generateUUID()
    let headers = {
        "Origin": "https://yiyan.baidu.com",
        "User-Agent": "Mozilla/5.0 (Linux; Android 16) AppleWebKit/537.36"
    }

    try {
        ws = new Websocket(wsUrl, headers)
    } catch (e) {
        logger.e("WebSocket失败: " + e.message)
        callback.error("WebSocket失败: " + e.message)
        return
    }

    let isFlushed = false
    let receivedEndFrame = false
    
    const flushAudio = function(reason) {
        logger.d("flushAudio被调用, reason: " + reason)
        if (isFlushed) {
            logger.d("已经处理过了，跳过")
            return
        }
        isFlushed = true
        audioState.isFinished = true

        try {
            logger.d("音频块数量: " + audioState.chunks.length)
            logger.d("音频总长度: " + audioState.totalLength)
            
            if (audioState.chunks.length > 0) {
                // 检查是否是MP3格式
                let firstChunk = audioState.chunks[0]
                let isMp3 = firstChunk.length >= 2 && firstChunk[0] === 0xff && 
                           (firstChunk[1] === 0xf3 || firstChunk[1] === 0xfb)
                
                let stream = new java.io.ByteArrayOutputStream()
                
                // 直接拼接所有音频数据块
                for (let chunk of audioState.chunks) {
                    for (let byte of chunk) {
                        stream.write(byte & 0xFF)
                    }
                }

                let finalBytes = stream.toByteArray()
                callback.write(finalBytes)
                stream.close()

                try { java.lang.Thread.sleep(200) } catch(e) {}
            } else {
                logger.w("无音频数据: " + reason)
            }
        } catch (e) {
            logger.e("flushAudio异常: " + e)
        } finally {
            callback.close()
        }
    }

    ws.on('close', function(code, reason) {
        logger.d("WebSocket关闭: code=" + code + " reason=" + reason)
        // 关闭WebSocket时刷新音频
        flushAudio("Close:" + code)
        ws = null
    })

    ws.on('error', function(err, resp) {
        logger.e("WebSocket错误: " + err)
        flushAudio("Error")
        ws = null
    })

    ws.on('binary', function(buffer) {
        try {
            if (buffer.length < 20) {
                // 检查是否为握手结束帧 (12字节: 08 00 00 00 00 01 01 5f 00 00 00 00)
                if (buffer.length === 12) {
                    let isEndFrame = true
                    let expected = [0x08, 0x00, 0x00, 0x00, 0x00, 0x01, 0x01, 0x5f, 0x00, 0x00, 0x00, 0x00]
                    for (let i = 0; i < 12; i++) {
                        if ((buffer[i] & 0xFF) !== expected[i]) {
                            isEndFrame = false
                            break
                        }
                    }
                    if (isEndFrame) {
                        receivedEndFrame = true
                        logger.i("收到握手结束帧，准备完成")
                        // 如果已经收到最后一块，则刷新音频并关闭
                        if (audioState.receivedLastChunk && !isFlushed) {
                            flushAudio("ServerEndFrame")
                        }
                        // 关闭WebSocket
                        if (ws != null) {
                            try { ws.close(1000, "server-end") } catch(e) {}
                        }
                        return
                    }
                }
                logger.w("消息太短，忽略")
                return
            }
            
            // 查找JSON开始位置
            let jsonStart = -1
            for (let i = 0; i < buffer.length && i < 100; i++) {
                if (buffer[i] == 0x7b) {
                    jsonStart = i
                    break
                }
            }
            
            if (jsonStart > 0) {
                // 找到JSON结束
                let jsonEnd = -1
                for (let i = jsonStart; i < buffer.length && i < jsonStart + 1000; i++) {
                    if (i + 1 < buffer.length && buffer[i] == 0x7d && buffer[i+1] == 0x0a) {
                        jsonEnd = i + 1
                        break
                    }
                }
                if (jsonEnd > 0) {
                    // 手动复制字节数组
                    let jsonLen = jsonEnd - jsonStart
                    let jsonBytes = new java.io.ByteArrayOutputStream()
                    for (let i = jsonStart; i < jsonEnd; i++) {
                        jsonBytes.write(buffer[i] & 0xFF)
                    }
                    let jsonStr = new java.lang.String(jsonBytes.toByteArray(), "UTF-8")
                    jsonBytes.close()
                    
                    try {
                        let meta = JSON.parse(jsonStr)
                        logger.i("收到音频块: idx=" + meta.idx + ", len=" + meta.audio_len + ", percent=" + meta.percent)
                        
                        if (meta.audio_len > 0 && jsonEnd + 1 < buffer.length) {
                            // 提取音频数据
                            let rawData = []
                            for (let i = jsonEnd + 1; i < buffer.length; i++) {
                                rawData.push(buffer[i] & 0xFF)
                            }
                            
                            // 检查格式
                            let audioBytes
                            if (rawData[0] === 0xff && (rawData[1] === 0xf3 || rawData[1] === 0xfb)) {
                                // MP3格式
                                audioBytes = rawData
                            } else if (rawData[0] === 0x45 && rawData[1] === 0x00) {
                                // 百度自定义格式，跳过8字节头部
                                audioBytes = rawData.slice(8)
                            } else {
                                // 未知格式，直接使用
                                audioBytes = rawData
                            }
                            if (audioBytes.length > 0) {
                                audioState.chunks.push(audioBytes)
                                audioState.totalLength += audioBytes.length
                            }
                        }
                        
                        // 检查是否最后一块：
                        // 1. idx < 0 表示最后一块（如-3, -4, -13等）
                        // 2. 记录已完成音频块接收，等待服务器发送握手结束帧
                        let isLastChunk = meta.idx < 0
                        if (isLastChunk) {
                            audioState.receivedLastChunk = true
                            if (receivedEndFrame && !isFlushed) {
                                flushAudio("Complete")
                                try {
                                    if (ws != null) {
                                        ws.close(1000, "done")
                                        ws = null
                                    }
                                } catch (e) {}
                            }
                        }
                    } catch (e) {
                        logger.e("JSON解析失败: " + e + ", jsonStr=" + jsonStr)
                    }
                } else {
                    logger.w("未找到JSON结束标记")
                }
            } else {
                logger.w("未找到JSON开始标记")
            }
        } catch (e) {
            logger.e("处理消息异常: " + e)
        }
    })

    ws.on('open', function() {
        try {
            // 严格按照抓包格式构建二进制消息
            let sn = generateUUID()
            let cuid = generateCUID()
            let textLen = String(req.text).length
            let queryText = textLen > 50 ? req.text.substring(0, 50) : req.text
            
            logger.d("请求音色ID: " + req.voice)
            
            let params = {
                pdt: 10170,
                key: "com.baidu.newapp",
                sn: sn,
                ctp: 10,
                multiplex: 1,
                tex: req.text,
                cuid: cuid,
                lip: 0,
                spd: req.speed,
                pit: req.pitch,
                vol: req.volume,
                per: parseInt(req.voice),
                aue: 3,  // MP3格式
                ver: "6.2.4.8907490",
                rate: 64,
                lan: "ZH",
                xml: 0,
                mode: 0,
                platform: "Android",
                audio_ctrl: JSON.stringify({
                    sampling_rate: 24000,
                    mid: "",
                    pack_size_type: 1
                }),
                text_ctrl: JSON.stringify({
                    session: {
                        session_id: String(Math.floor(Math.random() * 10000000)),
                        turn_index: Math.floor(Math.random() * 10000000),
                        user_query: queryText,
                        uid: cuid,
                        sub_index: 1
                    }
                })
            }
            
            let jsonStr = JSON.stringify(params)
            let jsonBytes = ttsrv.strToBytes(jsonStr)
            
            // 构建TLV格式消息
            // 真实格式: [4字节长度] [02 01 01 01] [JSON]
            // 长度 = JSON长度 + 4 (只包含 02 01 01 01)
            let msgLen = jsonBytes.length + 4
            
            // 使用Java ByteArrayOutputStream构建消息（正确处理有符号字节）
            let baos = new java.io.ByteArrayOutputStream()
            // 4字节长度（小端）
            baos.write(msgLen & 0xFF)
            baos.write((msgLen >> 8) & 0xFF)
            baos.write((msgLen >> 16) & 0xFF)
            baos.write((msgLen >> 24) & 0xFF)
            // 4字节固定头部: 02 01 01 01
            baos.write(0x02)
            baos.write(0x01)
            baos.write(0x01)
            baos.write(0x01)
            // JSON字节
            baos.write(jsonBytes)
            
            let finalMsg = baos.toByteArray()
            baos.close()
            
            logger.d("消息长度: " + finalMsg.length + ", JSON长度: " + jsonBytes.length)
            logger.d("消息前20字节hex: " + bytesToHex(finalMsg, 20))
            
            // 发送二进制数据
            try {
                logger.d("finalMsg类型: " + typeof finalMsg)
                logger.d("finalMsg长度: " + finalMsg.length)
                
                // NativeWebSocket.send 支持: CharSequence, ByteArray, NativeUint8Array, NativeArrayBuffer
                // 将Java字节数组转换为JavaScript Uint8Array
                let uint8Array = new Uint8Array(finalMsg.length)
                for (let i = 0; i < finalMsg.length; i++) {
                    uint8Array[i] = finalMsg[i] & 0xFF
                }
                logger.d("转换为Uint8Array，长度: " + uint8Array.length)
                
                ws.send(uint8Array)
                logger.i("请求发送成功")
            } catch (e) {
                logger.e("发送失败: " + e)
                throw e
            }
        } catch (e) {
            logger.e("发送请求失败: " + e)
        }
    })
}

