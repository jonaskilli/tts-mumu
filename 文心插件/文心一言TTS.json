function generateUUID() {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
        var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8)
        return v.toString(16)
    })
}

function generateCUID() {
    // 生成32位十六进制字符
    let chars = 'ABCDEF0123456789'
    let result = ''
    for (let i = 0; i < 32; i++) {
        result += chars.charAt(Math.floor(Math.random() * chars.length))
    }
    // 格式: HEX|VNO随机数
    let vnoNum = ''
    for (let i = 0; i < 10; i++) {
        vnoNum += chars.charAt(Math.floor(Math.random() * chars.length))
    }
    return result + '|VNO' + vnoNum
}

// WAV头写入
function writeString(stream, str) {
    for (let i = 0; i < str.length; i++) stream.write(str.charCodeAt(i))
}
function writeInt(stream, val) {
    stream.write(val & 0xFF)
    stream.write((val >> 8) & 0xFF)
    stream.write((val >> 16) & 0xFF)
    stream.write((val >> 24) & 0xFF)
}
function writeShort(stream, val) {
    stream.write(val & 0xFF)
    stream.write((val >> 8) & 0xFF)
}
function writeWavHeader(stream, dataLength, sampleRate) {
    let channels = 1
    let bitsPerSample = 16
    let byteRate = sampleRate * channels * bitsPerSample / 8
    let blockAlign = channels * bitsPerSample / 8

    writeString(stream, 'RIFF')
    writeInt(stream, 36 + dataLength)
    writeString(stream, 'WAVE')
    writeString(stream, 'fmt ')
    writeInt(stream, 16)
    writeShort(stream, 1)
    writeShort(stream, channels)
    writeInt(stream, sampleRate)
    writeInt(stream, byteRate)
    writeShort(stream, blockAlign)
    writeShort(stream, bitsPerSample)
    writeString(stream, 'data')
    writeInt(stream, dataLength)
}

// 构建TTS请求消息
function buildTtsRequest(text, voiceId, speed, pitch, volume) {
    logger.d("buildTtsRequest开始")
    
    let sn = generateUUID()
    let cuid = generateCUID()
    
    logger.d("生成的SN: " + sn)
    logger.d("生成的CUID: " + cuid)
    logger.d("文本长度: " + (text ? String(text).length : 0))
    logger.d("音色ID: " + voiceId)
    logger.d("参数 - spd:" + speed + " pit:" + pitch + " vol:" + volume)
    
    // 安全获取子串
    let textLen = String(text).length
    let queryText = text
    if (textLen > 50) {
        queryText = text.substring(0, 50)
    }
    
    let params = {
        pdt: 10170,
        key: "com.baidu.newapp",
        sn: sn,
        ctp: 10,
        multiplex: 1,
        tex: text,
        cuid: cuid,
        lip: 0,
        spd: speed,
        pit: pitch,
        vol: volume,
        per: parseInt(voiceId),
        aue: 2,
        ver: "6.2.4.8907490",
        rate: 64,
        lan: "ZH",
        xml: 0,
        mode: 0,
        platform: "Android",
        audio_ctrl: JSON.stringify({
            sampling_rate: 24000,
            mid: "",
            pack_size_type: 1
        }),
        text_ctrl: JSON.stringify({
            session: {
                session_id: String(Math.floor(Math.random() * 10000000)),
                turn_index: Math.floor(Math.random() * 10000000),
                user_query: queryText,
                uid: cuid,
                sub_index: 1
            }
        })
    }
    
    let jsonStr = JSON.stringify(params)
    logger.d("JSON长度: " + jsonStr.length)
    logger.d("JSON前100: " + (jsonStr.length > 100 ? jsonStr.substring(0, 100) + "..." : jsonStr))
    
    // 构建二进制消息
    let jsonBytes = ttsrv.strToBytes(jsonStr)
    logger.d("jsonBytes长度: " + jsonBytes.length)
    
    // 真实格式: [4字节长度] [02 01 01 01] [JSON]
    let msgLen = jsonBytes.length + 4
    logger.d("消息总长度: " + msgLen)
    
    // 使用Java ByteArrayOutputStream构建消息
    let baos = new java.io.ByteArrayOutputStream()
    baos.write(msgLen & 0xFF)
    baos.write((msgLen >> 8) & 0xFF)
    baos.write((msgLen >> 16) & 0xFF)
    baos.write((msgLen >> 24) & 0xFF)
    baos.write(0x02)
    baos.write(0x01)
    baos.write(0x01)
    baos.write(0x01)
    baos.write(jsonBytes)
    
    let finalBytes = baos.toByteArray()
    baos.close()
    
    logger.d("最终消息长度: " + finalBytes.length)
    logger.d("消息前20字节hex: " + bytesToHex(finalBytes, 20))
    
    // 转换为Uint8Array
    let resultArray = new Uint8Array(finalBytes.length)
    for (let i = 0; i < finalBytes.length; i++) {
        resultArray[i] = finalBytes[i] & 0xFF
    }
    
    return resultArray
}

// 字节转hex用于调试
function bytesToHex(bytes, len) {
    let hex = []
    let count = Math.min(bytes.length, len || bytes.length)
    for (let i = 0; i < count; i++) {
        let h = (bytes[i] & 0xFF).toString(16)
        if (h.length < 2) h = '0' + h
        hex.push(h)
    }
    return hex.join('')
}

// 插件对象
let PluginJS = {
    "name": "文心一言TTS",
    "id": "wenxin.tts",
    "author": "TTS Server",
    "version": 2,
    "iconUrl": "https://www.baidu.com/favicon.ico",
