<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://tony19.github.io/logback-android/xml"
    xsi:schemaLocation="https://tony19.github.io/logback-android/xml https://cdn.jsdelivr.net/gh/tony19/logback-android/logback.xsd">

    <property name="LOG_DIR" value="/storage/emulated/0/Android/data/${PACKAGE_NAME}/cache/log" />

    <appender name="logcat" class="ch.qos.logback.classic.android.LogcatAppender">
        <tagEncoder>
            <pattern>%logger{12}</pattern>
        </tagEncoder>
        <encoder>
            <pattern>[%-20thread] %msg</pattern>
        </encoder>
    </appender>

    <appender name="CrashLog" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/crash.log</file>

        <encoder>
            <immediateFlush>true</immediateFlush>
            <pattern>%d{MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>

        <filter class="com.github.jing332.tts_server_android.CrashFilter" />

        <!-- 体积上限（用户 09-08：防日志积累） -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/crash_%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>2MB</maxFileSize>
            <maxHistory>3</maxHistory>
            <totalSizeCap>5MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="Log" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/debug.log</file>
        <encoder>
            <pattern>%d{MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/debug_%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>2</maxHistory>
            <totalSizeCap>20MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="SystemTTS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/system_tts.log</file>
        <encoder>
            <!-- configId/roleName 经 MDC 落盘（用户 09-08）：重启后旧日志行仍可点开快捷面板 -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} | %-5level | %X{configId} | %X{roleName} | %msg%n</pattern>
        </encoder>

        <filter class="com.github.jing332.tts_server_android.SysttsFilter" />
        <!-- 体积上限（用户 09-08：插件日志刷屏场景防膨胀；插件日志缓冲另限2000条内存） -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/system_tts_%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>1</maxHistory>
            <totalSizeCap>30MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <root level="TRACE">
        <appender-ref ref="logcat" />
        <appender-ref ref="CrashLog" />
        <appender-ref ref="Log" />
        <appender-ref ref="SystemTTS" />
    </root>
</configuration>
